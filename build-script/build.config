# === GraalVM Build Configuration ===
# This file defines paths used by build.sh.
# These values should be adapted to the local setup.

# Define the path to the GraalVM bin directory (where tools like web-image live).
# Example: /home/<user>/Oracle/graal/sdk/mxbuild/linux-amd64/GRAALVM_<BUILD_ID>/graalvm-<build-id>-java25-25.1.0-dev/bin
GRAALVM_BIN=/home/arthur/.jdks/graalvm-25.1.0-dev+8.1/bin

# Optional override for JAVA_HOME.
# Leave empty to use your system default JDK, or set to a specific JDK path.
# Example: /usr/lib/jvm/java-25-openjdk
JAVA_HOME_OVERRIDE=/usr/lib/jvm/java-25-openjdk